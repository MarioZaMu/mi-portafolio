# Copia este archivo como .env.local (no se sube al repositorio) y en Vercel
# agrega las mismas variables en Settings → Environment Variables.

# ID del formulario de Formspree (la parte final de https://formspree.io/f/XXXXXXXX).
# Si está vacío, el formulario abre el cliente de correo (mailto) como alternativa.
NEXT_PUBLIC_FORMSPREE_ID=

# URL pública del sitio (para Open Graph). Ej.: https://mario-zambrano.vercel.app
NEXT_PUBLIC_SITE_URL=
